{
  "pluginAlias": "OpenLinko",
  "pluginType": "platform",
  "singular": true,
  "strictValidation": false,
  "headerDisplay": "Apple Home for your CarLinko car, through your own [OpenLinko](https://github.com/GodrezJr2/openlinko) dashboard. The plugin only talks to OpenLinko: it never logs in to CarLinko itself, so OpenLinko must be running and logged in with an account the car's T-Box accepts.",
  "footerDisplay": "Engine start is deliberately not exposed. Remote commands need the car to have mobile signal; a sleeping car may take a moment or not confirm.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Platform name",
        "type": "string",
        "default": "OpenLinko",
        "required": true
      },
      "url": {
        "title": "OpenLinko dashboard URL",
        "type": "string",
        "default": "http://127.0.0.1:8088",
        "placeholder": "http://127.0.0.1:8088",
        "format": "uri",
        "description": "Where your OpenLinko server runs. Same machine: http://127.0.0.1:8088."
      },
      "password": {
        "title": "Dashboard password",
        "type": "string",
        "description": "Only if you set a dashboard password in OpenLinko. Leave empty otherwise.",
        "x-schema-form": { "type": "password" }
      },
      "carName": {
        "title": "Car name",
        "type": "string",
        "default": "Car",
        "placeholder": "Car",
        "description": "Used for the tile names: \"Car\", \"Car A/C\", \"Find Car\"... Say \"Hey Siri, lock the Car\"."
      },
      "lock": {
        "title": "Lock (with battery level and charging)",
        "type": "boolean",
        "default": true
      },
      "lowBattery": {
        "title": "Low battery below (%)",
        "type": "integer",
        "default": 20,
        "minimum": 0,
        "maximum": 100
      },
      "climate": {
        "title": "A/C (on/off and temperature)",
        "type": "boolean",
        "default": true
      },
      "defaultTemp": {
        "title": "A/C temperature until the car reports one (°C)",
        "type": "number",
        "default": 22,
        "minimum": 15.5,
        "maximum": 30.5
      },
      "find": {
        "title": "Find car (horn and lights)",
        "type": "boolean",
        "default": true
      },
      "windows": {
        "title": "Windows (close / vent / open)",
        "type": "boolean",
        "default": true
      },
      "sunroof": {
        "title": "Sunroof (close / tilt / open)",
        "type": "boolean",
        "default": false
      },
      "liftgate": {
        "title": "Power liftgate / boot",
        "type": "boolean",
        "default": false,
        "description": "Shown as a garage door, so Home asks for Face ID / passcode before opening it."
      },
      "doors": {
        "title": "Doors contact sensor (any door or the boot open)",
        "type": "boolean",
        "default": true
      },
      "home": {
        "title": "Car at home",
        "type": "object",
        "properties": {
          "enabled": {
            "title": "Show a \"Car Home\" sensor",
            "type": "boolean",
            "default": false,
            "description": "Needs OpenLinko's car location feature (\"location\": true). Great for automations: car arrives, porch light on."
          },
          "lat": {
            "title": "Home latitude",
            "type": "number",
            "placeholder": "3.1579",
            "condition": { "functionBody": "return model.home && model.home.enabled === true;" }
          },
          "lng": {
            "title": "Home longitude",
            "type": "number",
            "placeholder": "101.7116",
            "condition": { "functionBody": "return model.home && model.home.enabled === true;" }
          },
          "radius": {
            "title": "Radius (m)",
            "type": "integer",
            "default": 150,
            "minimum": 50,
            "maximum": 5000,
            "condition": { "functionBody": "return model.home && model.home.enabled === true;" }
          }
        }
      }
    }
  },
  "layout": [
    { "type": "fieldset", "title": "Connection", "items": ["url", "password", "carName"] },
    { "type": "fieldset", "title": "Tiles", "description": "Only tiles your car supports are created, whatever is ticked here.",
      "items": ["lock", "lowBattery", "climate", "defaultTemp", "find", "windows", "sunroof", "liftgate", "doors"] },
    { "type": "fieldset", "title": "Car at home", "expandable": true,
      "items": ["home.enabled", "home.lat", "home.lng", "home.radius"] }
  ]
}
